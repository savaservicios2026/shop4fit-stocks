rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Usuario técnico que usan los importadores automáticos de correo y WhatsApp (se crea en Firebase Authentication).
    function esImportador() {
      return request.auth != null && request.auth.token.email == 'importador@shop4fit-stocks.firebaseapp.com';
    }

    // El acceso de oficina (cualquier otro usuario de Firebase Auth) puede leer y escribir todo.
    match /{coleccion}/{id} {
      allow read, write: if request.auth != null && !esImportador()
        && coleccion in ['productos', 'movimientos', 'pedidosProveedor', 'pedidosCliente', 'solicitudes'];
    }

    // El importador solo puede crear solicitudes nuevas y añadir mensajes a las existentes; nunca leer el resto ni borrar.
    match /solicitudes/{id} {
      allow create: if esImportador() && request.resource.data.mensajes is list;
      allow update: if esImportador()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mensajes', 'ultimo', 'sinLeer'])
        && request.resource.data.mensajes.size() >= resource.data.mensajes.size();
    }

    // Marcador de hasta dónde ha leído el importador de correo.
    match /importador/{id} {
      allow read, write: if esImportador();
    }
  }
}
