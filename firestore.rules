rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Solo el acceso de oficina (usuario de Firebase Auth) puede leer y escribir.
    match /{coleccion}/{id} {
      allow read, write: if request.auth != null
        && coleccion in ['productos', 'movimientos', 'pedidosProveedor', 'pedidosCliente'];
    }
  }
}
